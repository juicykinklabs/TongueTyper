#define TFT_DC D1
#define TFT_CS D2
//#define TFT_RST D3
//#define TFT_BL NOT DEFINED!

#define XIAO_SCK D8
#define XIAO_MISO D9
#define XIAO_MOSI D10

#define I2S_BCLK D0 // Bit clock
#define I2S_LRC D3  // Word select (LR clock)
#define I2S_DOUT D6 // Data out to DAC

#define SD_CS D4
#define ADXL_CS D5

SdFat32 SD_as_f32;
SdSpiConfig sdConfig(SD_CS, SHARED_SPI, SD_SCK_MHZ(25), &SPI); // just for the imageReader
Adafruit_GC9A01A tft(&SPI, TFT_DC, TFT_CS);
Adafruit_ImageReader reader(SD_as_f32);

Audio audio;

SemaphoreHandle_t metaSPIbustransactionMutex = NULL;

