void do_heartbeat(void *pv)
{
    pinMode(21, OUTPUT);
    while (1)
    {
        digitalWrite(21, millis() % 1000 > 500);
        vTaskDelay((1000 / 10) / portTICK_PERIOD_MS);
    }
    vTaskDelete(NULL);
}

bool metaTransaction_showImage(const char *filename, bool clear = false)
{
    //  digitalWrite(TFT_RST, LOW);
    //  delay(500);
    //  digitalWrite(TFT_RST, HIGH);

    tft.begin(40000000);

    if (clear)
    {
        tft.fillScreen(GC9A01A_BLACK);
        return true;
    }

    tft.setRotation(3);

    bool success = SD_as_f32.begin(sdConfig);
    if (!success)
    {
        debugln("SD card is no bueno");
    }
    reader.drawBMP(filename, tft, 0, 0, true);
    SD_as_f32.end();

    return success;
}

bool metaTransaction_playSound(const char *filename)
{
    // assumptions
    // sd_cs configured as output
    // this is blocking, if we want to read user input while sound is still playing,
    // we'll need a task
    SPI.end();
    SPI.begin(XIAO_SCK, XIAO_MISO, XIAO_MOSI); // might need this
    SPI.setFrequency(1000000);
    SD.begin(SD_CS);

    audio.setVolume(18); // 0...21
    uint32_t t_playStart = millis();
    audio.connecttoFS(SD, filename);
    uint32_t t_duration = (audio.getAudioFileDuration() * 1000 + 1000); // must round up
    while (millis() - t_playStart < t_duration)
    {
        audio.loop();
        vTaskDelay(1);
    }
    SD.end();

    return true;
}

uint8_t adxl_readRegister(uint8_t reg)
{
    // an AI tried to write this and it was ASS so i rewrote it
    uint8_t buffer[2] = {reg | (uint8_t)0x80, (uint8_t) 0xFF};
    //SPI.begin(XIAO_SCK, XIAO_MISO, XIAO_MOSI);
    SPI.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE3));
    digitalWrite(ADXL_CS, LOW);
    NOP();
    SPI.transfer(buffer, 2); // 1 byte address, 1 byte return
    digitalWrite(ADXL_CS, HIGH);
    SPI.endTransaction();

    return buffer[1];
}

void adxl_writeRegister(uint8_t reg, uint8_t value)
{
    uint8_t buffer[2] = {reg, value};
    //SPI.begin(XIAO_SCK, XIAO_MISO, XIAO_MOSI);
    SPI.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE3));
    digitalWrite(ADXL_CS, LOW);
    NOP();
    SPI.transfer(buffer, 2);
    digitalWrite(ADXL_CS, HIGH);
    SPI.endTransaction();
}

bool adxl_writeAndVerifyRegister(uint8_t reg, uint8_t value) {
    // write to a register, then read it back to verify
    adxl_writeRegister(reg, value);
    return (adxl_readRegister(reg) == value);

}

void adxl_earlySPIinit() {
    pinMode(ADXL_CS, OUTPUT);
    digitalWrite(ADXL_CS, HIGH);
    delayMicroseconds(10); // "bring CS high before changing clock polarity and phase"
    SPI.begin(XIAO_SCK, XIAO_MISO, XIAO_MOSI); // need this!
    bool success = false;
    while(!success) {
        delay(10);
        success = true;
        uint8_t deviceID = adxl_readRegister(0x00); // get devid
        success = success && (deviceID == 0xE5);
        success = success && adxl_writeAndVerifyRegister(0x31, 0b00101101);       // data: 4wire, fullres 4mg/lsb, leftjust, 4g range
        success = success && adxl_writeAndVerifyRegister(0x2D, 0x08);             // power on
        success = success && adxl_writeAndVerifyRegister(0x2C, 0b1010); // set to 100Hz
        
        if (!success) {
            debugln("one or more adxl initialization writes did not verify");
        }
    }
}

void do_adxl(void *pv)
{
    static bool printOnNextMutexFail = true;   
    while (1)
    {
        /* Get a new sensor event */
        if (xSemaphoreTake(metaSPIbustransactionMutex, (TickType_t)10) == pdTRUE)
        {
            // fucking dogshit adafruit library. no offense ada

            uint16_t x, y, z;

            uint8_t buf[7] = {0};
            buf[0] = 0x32 | 0x80 | 0x40; // DATAX0, read, multi-byte
            // trying spi.begin before begintransaction in case some registers are overwritten by i2s0
            //SPI.end();
            SPI.begin(XIAO_SCK, XIAO_MISO, XIAO_MOSI);
            SPI.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE3));
            digitalWrite(ADXL_CS, LOW);
            SPI.transfer(buf, 7); // address + 6 data bytes, CS never released
            digitalWrite(ADXL_CS, HIGH);
            SPI.endTransaction();

            x = (int16_t)((buf[2] << 8) | buf[1]);
            y = (int16_t)((buf[4] << 8) | buf[3]);
            z = (int16_t)((buf[6] << 8) | buf[5]);

            xSemaphoreGive(metaSPIbustransactionMutex);

            // at 4 milli-geez per lesbian, twos complement style
            // something something 2s complement bullshitterino
            x = x >> 5;
            if (x & (1 << 10))
            {
                x ^= (1 << 15);
                x ^= (1 << 14);
                x ^= (1 << 13);
                x ^= (1 << 12);
                x ^= (1 << 11);
            }
            y = y >> 5;
            if (y & (1 << 10))
            {
                y ^= (1 << 15);
                y ^= (1 << 14);
                y ^= (1 << 13);
                y ^= (1 << 12);
                y ^= (1 << 11);
            }
            z = z >> 5;
            if (z & (1 << 10))
            {
                z ^= (1 << 15);
                z ^= (1 << 14);
                z ^= (1 << 13);
                z ^= (1 << 12);
                z ^= (1 << 11);
            }
            int16_t xcounts = ((int16_t)x);
            int16_t ycounts = ((int16_t)y);
            int16_t zcounts = ((int16_t)z);
            float x_ms2 = 4.0 * xcounts / 1000.0 * 9.81;
            float y_ms2 = 4.0 * ycounts / 1000.0 * 9.81;
            float z_ms2 = 4.0 * zcounts / 1000.0 * 9.81;
            Serial.printf("X: %f, Y: %f, Z: %f\n", x_ms2, y_ms2, z_ms2);

            printOnNextMutexFail = true;
        }
        else
        {
            if (printOnNextMutexFail)
            {
                debugln("adxl was blocked");
                printOnNextMutexFail = false;
            }
        }
        vTaskDelay((1000 / 50) / portTICK_PERIOD_MS);
    }

    vTaskDelete(NULL);
}

void setup()
{
    Serial.begin(115200);
    delay(2000);

    adxl_earlySPIinit();

    xTaskCreate(do_heartbeat, "LED heartbeat", 1024, NULL, 1, NULL);

    Audio::audio_info_callback = my_audio_info;

    pinMode(SD_CS, OUTPUT);
    digitalWrite(SD_CS, HIGH);

    Serial.println("about to try io matrix shit");
    bool success = audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
    if (!success)
    {
        debugln("I2s IO matrix config failed, probably");
    }
    Serial.println("finished..");
    delay(1000);

    //setTFTBrightness(0.35);

    metaSPIbustransactionMutex = xSemaphoreCreateMutex();
    // have to do this AFTER making a spi mutex. duh,
    xTaskCreate(do_adxl, "ADXL34X Function", 8192, NULL, 2, NULL);
}

void loop()
{
    if (xSemaphoreTake(metaSPIbustransactionMutex, (TickType_t)25) == pdTRUE)
    {

        metaTransaction_showImage("1fae4.bmp");
        metaTransaction_playSound("fard.mp3");
        xSemaphoreGive(metaSPIbustransactionMutex);
    }
    else
    {
        debugln("main loop was semaphore blocked for 25 ticks!!!");
    }
    vTaskDelay(750 / portTICK_PERIOD_MS);

    if (xSemaphoreTake(metaSPIbustransactionMutex, (TickType_t)25) == pdTRUE)
    {

        metaTransaction_showImage("1f975.bmp");
        metaTransaction_playSound("quickfart.mp3");
        xSemaphoreGive(metaSPIbustransactionMutex);
    }
    else
    {
        debugln("main loop was semaphore blocked for 25 ticks!!!");
    }
    vTaskDelay(750 / portTICK_PERIOD_MS);
}