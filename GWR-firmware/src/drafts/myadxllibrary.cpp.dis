SdFat32 SD_as_f32;
SdSpiConfig sdConfig(SD_CS, SHARED_SPI, SD_SCK_MHZ(25), &SPI); // just for the imageReader
Adafruit_GC9A01A tft(&SPI, TFT_DC, TFT_CS);
Adafruit_ImageReader reader(SD_as_f32);

ADXL343 accel(ADXL_CS, XIAO_SCK, XIAO_MISO, XIAO_MOSI);
Audio audio;

SemaphoreHandle_t metaSPIbustransactionMutex = NULL;

void setTFTBrightness(float b)
{
    const uint8_t TFT_BACKLIGHT_PIN = D0;
    pinMode(TFT_BACKLIGHT_PIN, OUTPUT); // OUTPUT or ANALOG?
    // analogWriteResolution(TFT_BACKLIGHT_PIN, 8);
    // analogWriteFrequency(TFT_BACKLIGHT_PIN, 100); // these were giving errors so lets leave em commented
    analogWrite(TFT_BACKLIGHT_PIN, (int)(255 * (b)));
}

void my_audio_info(Audio::msg_t m)
{
    //Serial.printf("%s: %s\n", m.s, m.msg);
}

void do_heartbeat(void *pv)
{
    pinMode(21, OUTPUT);
    while (1)
    {
        digitalWrite(21, millis() % 1000 > 500);
        vTaskDelay((1000 / 10) / portTICK_PERIOD_MS);
    }
    vTaskDelete(NULL);
}

