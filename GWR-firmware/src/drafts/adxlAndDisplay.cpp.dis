#define TFT_CS D2
#define TFT_RST D3

#define XIAO_SCK D8
#define XIAO_MISO D9
#define XIAO_MOSI D10

#define SD_CS D4
#define ADXL_CS D5

SemaphoreHandle_t SPIbustransactionMutex = NULL;

